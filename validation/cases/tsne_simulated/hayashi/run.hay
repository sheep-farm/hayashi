load "validation/cases/tsne_simulated/data/data.csv" as df
let m = tsne(df, x="x1,x2,x3", perplexity=10, iter=250, lr=100)
let emb = m.embedding
let km = kmeans(emb, x="dim0,dim1", k=3)
let nan = 0.0 / 0.0
let out = dataframe({
  "variable": ["n_clusters", "inertia", "pct_explained", "kl_divergence"],
  "coef": [km.fit.n_clusters, km.fit.inertia, km.fit.pct_explained, m.fit.kl_divergence],
  "std_err": [nan, nan, nan, nan]
})
let out2 = select(out, "variable", "coef", "std_err")
export(out2, "csv", "/dev/stdout")
