// Load the Wooldridge wage1 dataset from CSV.
// The dataset is generated by the reference scripts before this script runs.
load "validation/cases/summarize_wooldridge_wage1/data/wage1.csv" as df

// Summary statistics for wage with full detail.
let s = summarize(df, wage, detail=true)

// Export the result as JSON for automated comparison.
export(s, "json", "/dev/stdout")
