load "validation/cases/estat_endog_simulated/data/data.csv" as df
let m = iv(y ~ x, ~ z, df)
let r = estat_endog(y ~ x, ~ z, df)
let se = 0.0
let out = dataframe({
  "variable": ["f_stat", "p_value"],
  "coef": [r.f_stat, r.p_value],
  "std_err": [se, se]
})
let out2 = select(out, "variable", "coef", "std_err")
export(out2, "csv", "/dev/stdout")
