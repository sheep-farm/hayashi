load "validation/cases/umap_simulated/data/data.csv" as df
let m = umap(df, x="x1,x2,x3", neighbors=15, iter=200)
let emb = m.embedding
let km = kmeans(emb, x="dim0,dim1", k=3)
let nan = 0.0 / 0.0
let out = dataframe({
  "variable": ["n_clusters", "inertia", "pct_explained", "loss"],
  "coef": [km.fit.n_clusters, km.fit.inertia, km.fit.pct_explained, m.fit.loss],
  "std_err": [nan, nan, nan, nan]
})
let out2 = select(out, "variable", "coef", "std_err")
export(out2, "csv", "/dev/stdout")
