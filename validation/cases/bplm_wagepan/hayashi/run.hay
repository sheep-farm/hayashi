load "validation/cases/bplm_wagepan/data/wagepan.csv" as df

let m = bplm(lwage ~ union + married, df, id="nr")

let out = dataframe({
  "variable": ["lm_stat", "p_value"],
  "coef": [m.fit.lm_stat, m.fit.p_value],
  "std_err": [0.0, 0.0]
})

let out2 = select(out, "variable", "coef", "std_err")
export(out2, "csv", "/dev/stdout")
