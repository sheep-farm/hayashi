load "validation/cases/chamberlain_wagepan/data/wagepan.csv" as df

let m = chamberlain(lwage ~ union + married, df, id="nr", time="year")

let out = dataframe({
  "variable": ["f_stat", "p_value"],
  "coef": [m.f_stat, m.p_value],
  "std_err": [0.0, 0.0]
})

let out2 = select(out, "variable", "coef", "std_err")
export(out2, "csv", "/dev/stdout")
