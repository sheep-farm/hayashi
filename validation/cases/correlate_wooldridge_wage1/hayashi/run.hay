// Load the Wooldridge wage1 dataset from CSV.
load "validation/cases/correlate_wooldridge_wage1/data/wage1.csv" as df

// Pairwise correlations of wage, educ, exper, tenure.
let c = correlate(df, wage, educ, exper, tenure)

// Export the result as JSON for automated comparison.
export(c, "json", "/dev/stdout")
