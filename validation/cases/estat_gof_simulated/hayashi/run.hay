load "validation/cases/estat_gof_simulated/data/data.csv" as df
let m = logit(y ~ x, df)
let r = estat_gof(m, groups=10)
let se = 0.0
let out = dataframe({
  "variable": ["hl_stat", "p_value"],
  "coef": [r.hl_stat, r.p_value],
  "std_err": [se, se]
})
let out2 = select(out, "variable", "coef", "std_err")
export(out2, "csv", "/dev/stdout")
