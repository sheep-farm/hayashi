// Load the Wooldridge fertil2 dataset from CSV.
// The CSV uses "NA" for missing values; force the 0/1 dummies to float so they
// are not inferred as categorical or boolean.
load "validation/cases/poisson_fertil2/data/fertil2.csv" as df, types=["electric:float", "tv:float", "urban:float", "evermarr:float"]

// Filter out rows with missing electric or tv (NaN != NaN).
df = df |> filter(electric == electric && tv == tv)

// Poisson regression for number of children.
let m = poisson(children ~ educ + age + agesq + evermarr + urban + electric + tv, df)

// Export coefficient table for automated comparison.
export(m, "txt", "/dev/stdout")
