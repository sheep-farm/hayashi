load "validation/cases/cancorr_simulated/data/data.csv" as df

let m = cancorr(df, xvars=["x1", "x2"], yvars=["y1", "y2"])

let out = dataframe({
  "variable": ["cancorr_1", "cancorr_2", "wilks_lambda"],
  "coef": [m.cancorr[0], m.cancorr[1], m.wilks_lambda],
  "std_err": [0.0, 0.0, 0.0]
})

let out2 = select(out, "variable", "coef", "std_err")
export(out2, "csv", "/dev/stdout")
