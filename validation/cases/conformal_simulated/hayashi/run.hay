load "validation/cases/conformal_simulated/data/data.csv" as df
let m = conformal(y ~ x1 + x2, df, alpha=0.1, calib=0.3)
let out = dataframe({
  "variable": ["empirical_coverage", "conformal_quantile"],
  "coef": [m.fit.empirical_coverage, m.fit.quantile],
  "std_err": [0.0, 0.0]
})
let out2 = select(out, "variable", "coef", "std_err")
export(out2, "csv", "/dev/stdout")
