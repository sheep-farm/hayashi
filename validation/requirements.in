# Python dependencies for the Hayashi validation programme
# Compile with: pip-compile --generate-hashes --output-file validation/requirements.txt validation/requirements.in
# Install with: pip install --require-hashes -r validation/requirements.txt
#
# NOTE: pylpdid is installed separately from its git repository (see
# validation/requirements-git.txt and the CI workflow) because it does not
# publish versioned wheels that can be hashed.

econml>=0.17
linearmodels>=7.0
numpy>=1.26
pandas>=2.0
pymc>=5.0
PyWavelets>=1.5
pyyaml>=6.0
quantile-forest>=1.3
scikit-learn>=1.4
scipy>=1.10
setuptools>=59.0
statsmodels>=0.14
umap-learn>=0.5
wooldridge>=0.0.2
xgboost>=2.0

# nvidia-nccl-cu12 is a Linux-only transitive dependency of xgboost. Pinning it
# here with a platform marker keeps pip-compile from emitting an unconditional
# pin that breaks validation on macOS and Windows.
nvidia-nccl-cu12 ; sys_platform == "linux"

# Transitive dependencies that are platform-conditional in their parents.
# Pinning them unconditionally lets --require-hashes work on Windows runners,
# where pip-compile on Linux would otherwise omit them.
colorama
tzdata
